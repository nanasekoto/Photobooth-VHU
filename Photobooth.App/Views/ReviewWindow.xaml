<Window x:Class="Photobooth.App.Views.ReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Xem lại &amp; Trang trí • Photobooth VHU v0.2.0" Width="1380" Height="900" MinWidth="1000" MinHeight="700"
 Background="#F3F8FF" WindowStartupLocation="CenterOwner" Closing="Window_Closing" Loaded="Window_Loaded">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,16">
   <TextBlock Text="Xem lại &amp; Trang trí" FontSize="26" FontWeight="Bold" Foreground="#164F91"/>
   <TextBlock Text="Chọn bố cục, thêm sticker rồi xác nhận xuất ảnh. Bạn không cần chụp lại khi đổi bố cục." Margin="0,6,0,0" Foreground="#6080A5"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,16,0">
    <Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid x:Name="Thumbnails" Columns="4" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="#DDEBFB" Padding="10" CornerRadius="14">
     <Viewbox x:Name="SceneViewbox" Stretch="Uniform" SizeChanged="SceneViewbox_SizeChanged">
      <Canvas x:Name="Scene" Width="1200" Height="800" ClipToBounds="True" Background="White">
       <Image x:Name="CompositeImage" Width="1200" Height="800" Stretch="Fill" IsHitTestVisible="False"/>
       <Canvas x:Name="StickerCanvas" Width="1200" Height="800"/>
      </Canvas>
     </Viewbox>
    </Border>
   </Grid>
   <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Tools">
     <TextBlock Text="BỐ CỤC THÀNH PHẨM" FontWeight="Bold" Foreground="#1264C0"/>
     <ComboBox x:Name="LayoutCombo" SelectionChanged="Layout_Changed"/>
     <TextBlock Text="Frame sẽ đổi theo bố cục. Vị trí sticker được giữ theo tỷ lệ của ảnh ghép." TextWrapping="Wrap" Foreground="#6080A5" Margin="0,0,0,16"/>
     <TextBlock Text="THƯ VIỆN STICKER" FontWeight="Bold" Foreground="#1264C0"/>
     <TextBlock Text="Kéo để di chuyển • Kéo góc để resize • Bấm × để xóa" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="#6080A5"/>
     <WrapPanel x:Name="Library"/>
     <Button Content="Thêm PNG vào thư viện" Click="Import_Click"/>
     <Button Content="Xóa toàn bộ sticker" Click="Clear_Click"/>
     <TextBlock Text="Khi đổi sang lưới, sticker gần cạnh có thể được thu nhỏ để vẫn nằm trọn trong ảnh. Tọa độ vị trí vẫn giữ nguyên." TextWrapping="Wrap" Foreground="#6080A5" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="Chưa xuất file • Bạn có thể đổi bố cục và trang trí." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Foreground="#6080A5"/>
   <Button x:Name="ConfirmButton" Grid.Column="1" Content="Hoàn tất &amp; Nhận mã QR" Click="Confirm_Click" Background="#1264C0" Foreground="White" FontSize="17" Padding="24,14" IsEnabled="False"/>
  </Grid>
 </Grid>
</Window>
