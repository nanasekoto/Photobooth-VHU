<Window x:Class="Photobooth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mirai Photobooth" Height="820" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#0C0E14">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#222634"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F3548"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#353B50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#A3FF2E"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#A3FF2E" Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                    <TextBlock Text="✦" FontSize="22" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="MIRAI PHOTOBOOTH" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
                    <TextBlock Text="CUSTOM FRAMES &amp; STICKERS" FontSize="11" Foreground="#7A8294"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#1A1D27" CornerRadius="20" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#A3FF2E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ConnectionStatus" Text="WEBCAM HOẠT ĐỘNG" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ConnectButton" Click="ConnectCamera_Click" Content="Bật Webcam" Style="{StaticResource ModernBtn}" Margin="0,0,8,0"/>
                <Button Click="OpenOutputFolder_Click" Content="Thư mục ảnh" Style="{StaticResource ModernBtn}"/>
            </StackPanel>
        </Grid>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Khung Live View + Khung PNG + Sticker -->
            <Border Grid.Column="0" Background="#000000" CornerRadius="16" Margin="0,0,16,0" ClipToBounds="True">
                <Grid x:Name="CameraViewport">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <Image x:Name="FramePngOverlay" Stretch="Fill" IsHitTestVisible="False"/>
                    <Canvas x:Name="StickerCanvas" Background="Transparent"/>

                    <Border x:Name="CountdownOverlay" Background="#AA000000" Visibility="Collapsed">
                        <TextBlock x:Name="CountdownText" Text="3" FontSize="160" FontWeight="Black"
                                   Foreground="#A3FF2E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cột cấu hình bên phải -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Bộ lọc màu -->
                    <Border Background="#161822" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="01 · BỘ LỌC MÀU (LUT)" FontSize="12" FontWeight="Bold" Foreground="#A3FF2E" Margin="0,0,0,10"/>
                            <ComboBox x:Name="FilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" Margin="0,0,0,8">
                                <ComboBoxItem Content="Nguyên bản (Không lọc)" Tag="Original" IsSelected="True"/>
                                <ComboBoxItem Content="Vintage Ấm áp" Tag="Warm"/>
                                <ComboBoxItem Content="Đen trắng tương phản" Tag="BlackWhite"/>
                                <ComboBoxItem Content="3D LUT riêng (.cube)" Tag="CustomLut"/>
                            </ComboBox>
                            <Button Click="LoadLut_Click" Content="Nạp file .CUBE" Style="{StaticResource ModernBtn}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LutStatus" Text="Chưa chọn LUT" FontSize="11" Foreground="#6C7282"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Khung ảnh PNG -->
                    <Border Background="#161822" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="02 · KHUNG ẢNH (FILE PNG)" FontSize="12" FontWeight="Bold" Foreground="#A3FF2E" Margin="0,0,0,10"/>
                            <Button Click="LoadFramePng_Click" Content="🖼️ Chọn Khung viền PNG từ máy" Style="{StaticResource ModernBtn}" Margin="0,0,0,8"/>
                            <Button Click="ClearFrame_Click" Content="Xóa khung viền" Style="{StaticResource ModernBtn}" Background="#2A1E24" Foreground="#FF7A8A"/>
                            <TextBlock x:Name="FrameStatusText" Text="Chưa chọn khung PNG" FontSize="11" Foreground="#6C7282" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Sticker PNG -->
                    <Border Background="#161822" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="03 · THÊM STICKER (FILE PNG)" FontSize="12" FontWeight="Bold" Foreground="#A3FF2E" Margin="0,0,0,10"/>
                            <Button Click="AddCustomStickerPng_Click" Content="⭐ Thêm Sticker PNG từ máy" Style="{StaticResource ModernBtn}" Margin="0,0,0,8"/>
                            <TextBlock Text="Hoặc thêm nhanh Emoji:" FontSize="11" Foreground="#8A92A6" Margin="0,0,0,6"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Click="AddEmojiSticker_Click" Tag="❤️" Content="❤️" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                                <Button Click="AddEmojiSticker_Click" Tag="⭐" Content="⭐" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                                <Button Click="AddEmojiSticker_Click" Tag="🎀" Content="🎀" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                                <Button Click="AddEmojiSticker_Click" Tag="👑" Content="👑" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                                <Button Click="AddEmojiSticker_Click" Tag="🌸" Content="🌸" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                                <Button Click="AddEmojiSticker_Click" Tag="🕶️" Content="🕶️" FontSize="20" Style="{StaticResource ModernBtn}" Width="46" Height="46" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <Button Click="ClearStickers_Click" Content="Xóa tất cả sticker" Style="{StaticResource ModernBtn}" Background="#2A1E24" Foreground="#FF7A8A"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút Chụp -->
                    <Button x:Name="StartSessionButton" Click="StartSession_Click" Content="BẮT ĐẦU CHỤP (4 TẤM)"
                            Height="56" FontSize="16" FontWeight="Black" Background="#A3FF2E" Foreground="#000000"
                            Style="{StaticResource ModernBtn}" Margin="0,0,0,12"/>

                    <!-- Đường dẫn thư mục -->
                    <Border Background="#12141C" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Thư mục xuất ảnh:" FontSize="11" Foreground="#5E6575"/>
                            <TextBlock x:Name="OutputFolderText" Text="..." FontSize="11" Foreground="#9BA2B5" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                            <Button Click="ChooseOutputFolder_Click" Content="Đổi thư mục lưu" Style="{StaticResource ModernBtn}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" VerticalAlignment="Center">
            <TextBlock x:Name="FooterStatus" Text="Sẵn sàng." FontSize="12" Foreground="#5E6575"/>
            <TextBlock x:Name="SessionProgressText" HorizontalAlignment="Right" FontSize="12" Foreground="#A3FF2E"/>
        </Grid>
    </Grid>
</Window>