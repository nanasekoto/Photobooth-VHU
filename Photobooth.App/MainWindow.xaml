<Window x:Class="Photobooth.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Photobooth VHU" Width="1440" Height="900" MinWidth="1050" MinHeight="700"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="90"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#1264C0" CornerRadius="14" Padding="16,10" Margin="0,0,14,0"><TextBlock Text="VHU" Foreground="White" FontSize="23" FontWeight="Black"/></Border>
    <StackPanel><TextBlock Text="PHOTOBOOTH VHU" FontSize="24" FontWeight="Bold"/><TextBlock Text="Lưu khoảnh khắc • Kết nối thanh xuân" Foreground="#6080A5" FontSize="13"/></StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="ConnectButton" Content="Kết nối" Click="Connect_Click" Margin="8,0"/>
    <Button x:Name="SettingsButton" Content="Cài đặt" Click="Settings_Click" Margin="8,0"/>
    <Button Content="☰ Công cụ" Click="ToggleSidebar_Click" Margin="8,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SidebarColumn" Width="330"/></Grid.ColumnDefinitions>
   <Border Background="#DDEBFB" CornerRadius="18" Padding="12" Margin="0,0,16,0">
    <Grid>
     <Viewbox Stretch="Uniform">
      <Canvas x:Name="SceneCanvas" Width="1200" Height="800" Background="#0E3158" ClipToBounds="True">
       <Image x:Name="PreviewImage" Width="1200" Height="800" Stretch="Fill"/>
       <Image x:Name="LiveFrameImage" Width="1200" Height="800" Stretch="Fill" IsHitTestVisible="False"/>
       <Canvas x:Name="StickerCanvas" Width="1200" Height="800"/>
      </Canvas>
     </Viewbox>
     <Border x:Name="CountdownOverlay" Background="#500A2850" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="12">
      <TextBlock x:Name="CountdownText" FontSize="140" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </Grid>
   </Border>
   <Border x:Name="Sidebar" Grid.Column="1" Background="White" CornerRadius="18" Padding="16">
    <TabControl x:Name="ToolsTabs" BorderThickness="0" Background="White">
     <TabItem Header="Chuẩn bị">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PreparationPanel" Margin="8,18,8,0">
       <TextBlock Text="BỐ CỤC • 4 ẢNH" FontSize="12" FontWeight="Bold" Foreground="#1264C0"/>
       <ComboBox x:Name="LayoutCombo" SelectionChanged="Options_Changed"/>
       <TextBlock Text="MÀU SẮC" FontSize="12" FontWeight="Bold" Foreground="#1264C0"/>
       <ComboBox x:Name="FilterCombo" SelectionChanged="Options_Changed"/>
       <Button Content="Nạp LUT .cube" Click="LoadLut_Click"/>
       <TextBlock x:Name="LutLabel" Text="Chưa nạp LUT" TextWrapping="Wrap" Margin="0,4,0,20" Foreground="#6080A5"/>
       <Border Background="#F0F6FF" CornerRadius="12" Padding="14"><TextBlock Text="Chọn bố cục và màu trước khi chụp. Sau 4 tấm, bạn sẽ trang trí sticker trực tiếp trên ảnh ghép." TextWrapping="Wrap" FontSize="14" LineHeight="23"/></Border>
       <TextBlock x:Name="ModeLabel" TextWrapping="Wrap" FontSize="12" Foreground="#1264C0" Margin="0,18,0,0"/>
      </StackPanel></ScrollViewer>
     </TabItem>
     <TabItem x:Name="StickerTab" Header="Sticker" IsEnabled="False">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,18,8,0">
       <TextBlock Text="TRANG TRÍ ẢNH GHÉP" FontWeight="Bold" Foreground="#1264C0"/>
       <TextBlock Text="Kéo để di chuyển • Kéo góc để đổi kích thước • Bấm × để xóa" TextWrapping="Wrap" Margin="0,10,0,12" Foreground="#6080A5"/>
       <WrapPanel x:Name="StickerLibrary"/>
       <Button Content="Thêm sticker PNG vào thư viện" Click="ImportSticker_Click"/>
       <Button Content="Xóa toàn bộ sticker" Click="ClearStickers_Click"/>
      </StackPanel></ScrollViewer>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StepLabel" Text="01 • CHUẨN BỊ" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="ProgressLabel" Text="Kết nối để bắt đầu" Foreground="#6080A5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="NewSessionButton" Content="Phiên mới" Click="NewSession_Click" Margin="8,0" Visibility="Collapsed"/>
    <Button x:Name="CancelButton" Content="Hủy chụp" Click="Cancel_Click" Margin="8,0" Visibility="Collapsed"/>
    <Button x:Name="CaptureButton" Content="BẮT ĐẦU CHỤP (4 TẤM)" Click="Capture_Click" Background="#1264C0" Foreground="White" FontSize="17" Height="60" Padding="30,12" IsEnabled="False"/>
    <Button x:Name="FinishButton" Content="Hoàn tất &amp; Nhận mã QR" Click="Finish_Click" Background="#1264C0" Foreground="White" FontSize="17" Height="60" Padding="30,12" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="StatusLabel" Grid.Row="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#6080A5" FontSize="12"/>
 </Grid>
</Window>
