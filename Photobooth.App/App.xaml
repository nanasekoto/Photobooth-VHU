<Application x:Class="Photobooth.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#101116" />
    <SolidColorBrush x:Key="PanelBackground" Color="#191B23" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2A2D39" />
    <SolidColorBrush x:Key="MutedText" Color="#A2A6B5" />
    <SolidColorBrush x:Key="Accent" Color="#B9F36A" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F7F7FA" />
      <Setter Property="Background" Value="#292C38" />
      <Setter Property="BorderBrush" Value="#3A3E4D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#373B4A" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F7F7FA" />
      <Setter Property="Background" Value="#242733" />
      <Setter Property="BorderBrush" Value="#393D4B" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
  </Application.Resources>
</Application>
