<Application x:Class="Photobooth.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#1264C0"/>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#16365A"/><Setter Property="Background" Value="#F3F8FF"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#E7F0FD"/><Setter Property="Foreground" Value="#164F91"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,4"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="FontSize" Value="14"/></Style>
 </Application.Resources>
</Application>
